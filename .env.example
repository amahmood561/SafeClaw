# How SafeClaw thinks. Run `safeclaw init` to set this up interactively.
#
# The default is local: Ollama on this machine, nothing leaves it, no API key.
# Install Ollama from https://ollama.com then: ollama pull qwen2.5
#
# Provider presets: ollama, openai, groq, openrouter, litellm, custom
SAFECLAW_PROVIDER_PRESET=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5
OPENAI_API_KEY=ollama

# To use a hosted provider instead, replace the three lines above with, e.g.:
#   SAFECLAW_PROVIDER_PRESET=openai
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4.1-mini
#   OPENAI_API_KEY=your_key_here

# Agent settings
WORKSPACE=./workspace
ALLOW_SHELL=false
SAFECLAW_PERMISSION_PROFILE=readonly
SAFECLAW_APPROVAL_MODE=ask
MAX_TOOL_STEPS=50

# Optional read-only SQLite databases.
# Paths are relative to WORKSPACE and must stay inside it.
# Example: SAFECLAW_SQLITE_DATABASES=app=app.db,notes=data/notes.db
SAFECLAW_SQLITE_DATABASES=

# Optional Twilio WhatsApp outbound support.
# For inbound replies, point your Twilio WhatsApp webhook to:
#   https://your-public-url/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SAFECLAW_ALLOWED_SENDERS=

# Optional Telegram phone access.
# Install Telegram, create a bot with the verified @BotFather account,
# paste the token, optionally allowlist your numeric user ID, then run:
#   safeclaw telegram
TELEGRAM_BOT_TOKEN=
SAFECLAW_ALLOWED_TELEGRAM_USERS=
